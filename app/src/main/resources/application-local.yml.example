# Copy this file to application-local.yml and fill in local-only values.
# application-local.yml is ignored by Git.
app:
  dashscope:
    api-key: ""
    base-url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  oss:
    endpoint: "https://oss-cn-beijing.aliyuncs.com"
    region: "cn-beijing"
    bucket: ""
    access-key-id: ""
    access-key-secret: ""
  imm:
    endpoint: "imm.cn-beijing.aliyuncs.com"
    project-name: "IMM"
  bailian:
    knowledge-enabled: true
    workspace-id: ""
    knowledge-base-id: ""
  procurement-document:
    generation-model: "qwen3.7-plus"
    max-concurrency: 4

docextract:
  base-url: ${DASHSCOPE_OCR_BASE_URL:https://dashscope.aliyuncs.com/api/v1}
  api-key: ${DASHSCOPE_API_KEY:${app.dashscope.api-key:}}
  model: ${DASHSCOPE_OCR_MODEL:qwen3.5-ocr}
  max-file-bytes: ${DOCEXTRACT_MAX_FILE_BYTES:104857600}
